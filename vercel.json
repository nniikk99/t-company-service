{
  "version": 2,
  "buildCommand": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://telegram.org https://*.telegram.org https://t.me https://*.t.me;"
        },
        { "key": "X-Frame-Options", "value": "ALLOWALL" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/index.html", "statusCode": 308 },
    { "source": "/index", "destination": "/index.html", "statusCode": 308 },
    { "source": "/:path*", "destination": "/index.html", "statusCode": 308 }
  ]
}


